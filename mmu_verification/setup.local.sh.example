#!/bin/bash
# setup.local.sh.example — Server-specific EDA tool path configuration (bash/sh)
#
# INSTRUCTIONS:
#   cp setup.local.sh.example setup.local.sh
#   Edit setup.local.sh with your server's actual VCS/Verdi install paths.
#   This file is sourced automatically by setup_env.sh.
#   setup.local.sh is listed in .gitignore and will NOT be committed.
#
# Example for a typical Synopsys installation:
# -----------------------------------------------------------------------

# --- Synopsys VCS ---
# export VCS_HOME=/mnt/tools/synopsys/vcs/V-2023.12-SP2
# export PATH=${VCS_HOME}/bin:${PATH}

# --- Synopsys Verdi ---
# export VERDI_HOME=/mnt/tools/synopsys/verdi/V-2023.12-SP2
# export PATH=${VERDI_HOME}/bin:${PATH}

# --- Optional: VCS runtime libraries ---
# export LD_LIBRARY_PATH=${VCS_HOME}/lib:${LD_LIBRARY_PATH}

# --- Optional: License server ---
# export SNPSLMD_LICENSE_FILE=<port>@<license_server>

# --- Optional: Source a site-wide EDA setup script ---
# source /mnt/tools/env/eda.sh
