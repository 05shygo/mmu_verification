// =============================================================================
// FSM reset-path-only transition exclusions (MMU-P14-ISSUE-022)
// =============================================================================
// Each transition below was verified to have NO functional next-state path to
// the IDLE/reset state in the RTL combinational block, AND the state register
// has no abort-to-IDLE branch (only reset + functional next-state). The ONLY
// code path that fires these transitions is `if(!cpurst_b) state <= IDLE`,
// which requires mid-test reset assertion while the FSM is mid-operation.
// This never occurs in functional verification (reset is asserted only at boot).
// Functional uncovered transitions are NOT excluded here.
// =============================================================================

// CHECKSUM: "755350491 966419608"
// ANNOTATION: "ModuleName: ct_mmu_tlboper"
INSTANCE: tb_top.u_dut.x_ct_mmu_tlboper
// ANNOTATION: "FileName: mmu/rtl/ct_mmu_tlboper.v, LineNumber: 285 - tlbp state register reset"
Fsm tlbp_cur_st "3420717456"
Transition PWFG->IDLE "1->0"
// ANNOTATION: "FileName: mmu/rtl/ct_mmu_tlboper.v, LineNumber: 345 - tlbr state register reset"
Fsm tlbr_cur_st "3885275405"
Transition RWFG->IDLE "1->0"
// ANNOTATION: "FileName: mmu/rtl/ct_mmu_tlboper.v, LineNumber: 405 - tlbwi state register reset"
Fsm tlbwi_cur_st "3153498972"
Transition TLBOP_WFG->IDLE "1->0"
// ANNOTATION: "FileName: mmu/rtl/ct_mmu_tlboper.v, LineNumber: 467 - tlbwr state register reset"
Fsm tlbwr_cur_st "371666051"
Transition TLBWR_WFG->IDLE "2->0"
Transition WRTAG->IDLE "1->0"
// ANNOTATION: "FileName: mmu/rtl/ct_mmu_tlboper.v, LineNumber: 566 - tlbiasid state register reset"
Fsm tlbiasid_cur_st "4200474810"
Transition IASID_RD->IASID_IDLE "1->0"
Transition IASID_WFC->IASID_IDLE "2->0"
// ANNOTATION: "FileName: mmu/rtl/ct_mmu_tlboper.v, LineNumber: 870 - tlbiva state register reset"
Fsm tlbiva_cur_st "2172044265"
Transition IVA_CMP->IVA_IDLE "3->0"
Transition IVA_RD->IVA_IDLE "2->0"
Transition IVA_WR->IVA_IDLE "4->0"
Transition IVA_WT->IVA_IDLE "5->0"

// CHECKSUM: "3281562444 3597370733"
// ANNOTATION: "ModuleName: mmu_l2tlb"
INSTANCE: tb_top.u_dut.x_mmu_l2tlb
// ANNOTATION: "FileName: mmu/rtl/mmu_l2tlb.sv, LineNumber: 1347 - pfu state register reset"
Fsm pfu_cur_st "3597370733"
Transition PFU_CHK->PFU_IDLE "1->0"

